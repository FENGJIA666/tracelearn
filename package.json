{
  "name": "tracelearn",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "setup": "bash scripts/setup.sh",
    "prepare:review": "tsx scripts/prepare-review.ts",
    "build:portable": "tsx scripts/prepare-review.ts && tsx scripts/prepare-v13-review.ts && tsx scripts/build-portable.ts",
    "prepare:current-review": "tsx scripts/prepare-v13-review.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "lucide-react": "1.46.0",
    "multer": "2.4.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "vite": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2"
  }
}
